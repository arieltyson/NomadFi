# Copy this file to `.env` (already gitignored at the repo root and
# in this directory) and fill in your Plaid credentials. Never
# commit a real `.env`.
#
# Two operating modes — pick exactly one:
#
#   * Sandbox (default). Uses Plaid sandbox keys + the Plaid sandbox
#     environment per https://plaid.com/docs/sandbox/. Free, safe,
#     uses pre-defined test institutions and test credentials.
#
#   * Live-data evaluation. Uses Plaid PRODUCTION keys against
#     Plaid's production environment per https://plaid.com/docs/api/.
#     Requires:
#       - Plaid Dashboard production / Limited Production access
#         granted for `com.arieljtyson.NomadFi` (Plaid-side approval,
#         vendor-reported flow at https://plaid.com/docs/api/);
#       - PLAID_LIVE_DATA_EVALUATION=1 (deliberate opt-in flag —
#         a forgotten env change must NOT silently move you to live
#         data);
#       - a verified HTTPS redirect URI for OAuth testing outside
#         Canada-only coverage;
#       - LAN-mode shared secret rules continue to apply.
#
# See `docs/research/PlaidLimitedProductionReadiness.md` for the
# full live-data preflight runbook.

# ===== Plaid credentials ============================================
# Sandbox keys for sandbox mode; production keys for live-data mode.
PLAID_CLIENT_ID=your_plaid_client_id_here
PLAID_SECRET=your_plaid_secret_here

# ===== Plaid environment ============================================
# `sandbox` (default) or `production`. Selecting `production` also
# requires PLAID_LIVE_DATA_EVALUATION=1 below.
PLAID_ENV=sandbox

# Live-data evaluation opt-in. Must be `1` exactly when PLAID_ENV is
# `production`. Leave blank / unset for sandbox.
PLAID_LIVE_DATA_EVALUATION=

# ===== Plaid product / coverage =====================================
# Country codes Plaid Link should consider. CA covers the target
# Canadian FIs from the bakeoff memo (vendor-reported coverage at
# https://plaid.com/en-ca/).
PLAID_COUNTRY_CODES=CA
# Accounts and cached balances are available through /accounts/get.
# Auth is unnecessary for this read-only evaluation. Do not list balance.
PLAID_PRODUCTS=transactions

# Sandbox-only: which test institution `/sandbox/item/create` uses.
# Ignored in production mode (the endpoint is disabled there).
PLAID_SANDBOX_INSTITUTION_ID=ins_109508

# ===== iOS OAuth redirect URI =======================================
# Leave empty for the Canadian run. For OAuth testing, first verify
# the domain-root AASA and full redirect path; see the preflight doc.
PLAID_REDIRECT_URI=

# ===== Reachability =================================================
PORT=8787

# Default 127.0.0.1 (loopback only — a physical iPhone cannot reach
# this). Set to your Mac's LAN IP (e.g. 192.168.1.42) or 0.0.0.0
# only during active real-device evaluation. LAN mode requires
# PLAID_BROKER_SHARED_SECRET (>= 16 chars).
PLAID_BROKER_BIND_HOST=127.0.0.1

# Generate with: `openssl rand -hex 32`. Required when
# PLAID_BROKER_BIND_HOST is anything other than loopback.
PLAID_BROKER_SHARED_SECRET=
