# ===========================
# Xcode
# ===========================

## User-specific settings (window positions, breakpoints, bookmarks)
xcuserdata/

## Build artifacts (if per-project build location is configured)
DerivedData/

## Precompiled header maps
*.hmap

## SPM dependency resolution (app projects should resolve fresh)
*.xcodeproj/project.xcworkspace/xcshareddata/swiftpm/Package.resolved

## App packaging artifacts
*.ipa
*.dSYM.zip
*.dSYM

## Playgrounds
timeline.xctimeline
playground.xcworkspace

# ===========================
# Swift Package Manager
# ===========================
.build/

# ===========================
# Secrets & Environment
# ===========================
## API keys, environment configs — never commit these
*.xcconfig
!**/SharedSettings/*.xcconfig
Secrets/
.env
.env.*

# Local agent/editor settings
.claude/

# Localization catalogs are source files and should stay version controlled.
!**/*.xcstrings
