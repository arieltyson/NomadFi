#!/usr/bin/env bash
set -euo pipefail

repo_root="$(git rev-parse --show-toplevel)"
cd "$repo_root"

while IFS= read -r -d '' staged_file; do
  [[ -f "$staged_file" ]] || continue
  scripts/normalize-xcstrings.sh "$staged_file"
  git add -- "$staged_file"
done < <(git diff --cached --name-only -z --diff-filter=ACMR -- '*.xcstrings')
